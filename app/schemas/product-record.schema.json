{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecom-crawler/product-record.schema.json",
  "title": "D02 normalized product record",
  "description": "Internal record written to records.jsonl. The business CSV is a 9-column projection of this record.",
  "type": "object",
  "required": [
    "name",
    "price",
    "primary_image_url",
    "description_html",
    "description_status",
    "partial_reason",
    "missing_reasons",
    "categories",
    "category",
    "brand",
    "options",
    "attributes",
    "source_url",
    "market",
    "locale",
    "availability",
    "availability_observed",
    "sales_unit",
    "relations",
    "extracted_at"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "price": {
      "type": "object",
      "required": ["amount", "currency", "basis", "tax_basis"],
      "properties": {
        "amount": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "basis": {"type": "string", "minLength": 1},
        "tax_basis": {
          "enum": ["INCLUSIVE", "EXCLUSIVE", "NOT_SPECIFIED", "UNSPECIFIED"]
        },
        "displayed": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "pretax": {"type": ["number", "null"], "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "primary_image_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "description_html": {"type": "string"},
    "description_status": {
      "enum": ["COMPLETE", "PARTIAL", "SUMMARY_FALLBACK", "NOT_PROVIDED", "FAILED"]
    },
    "partial_reason": {"type": ["string", "null"]},
    "missing_reasons": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "categories": {
      "type": "array",
      "items": {"type": "string"}
    },
    "category": {"type": "string"},
    "brand": {"type": ["string", "null"]},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "attributes": {"type": "string"},
    "source_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "market": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 1},
    "availability": {"type": ["string", "null"]},
    "availability_observed": {"type": ["string", "null"]},
    "sales_unit": {"type": ["string", "null"]},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "html"],
        "properties": {
          "kind": {
            "enum": ["compatibility", "package", "ingredients"]
          },
          "html": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "extracted_at": {"type": ["string", "null"]},
    "field_sources": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  },
  "additionalProperties": true
}
